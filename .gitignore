# --- dependencies ---
node_modules/

# --- python venv ---
.venv/

# --- upstream sources (tracked in their own git repos) ---
upstream/

# --- dashr distro fork (own git repo; outer repo tracks only its contract files) ---
dashr/*
!dashr/AGENTS.md
!dashr/README.md

# --- graphify knowledge-graph output ---
graphify-out/
.graphifyignore

# --- scratch notes / disposable artifacts ---
.scratch/

# --- internal dev artifacts ---
dev/

# "./docs/" is assets, references, any others sit along with the repo

# --- internal exploration & research (never publish) ---
docs/60_exploration-and-research/
# --- build output ---
dist/
build/
lib/
*.tsbuildinfo
*.tsbuildinfo.*

# --- OS / editor ---
.DS_Store
Thumbs.db

# --- local agent tooling (keep on disk, never commit) ---
.agents/
.pi/

# --- dsh-better-edit runtime artifact (hash store written into cwd) ---
.dsh_better_edit/

# --- test rig runtime homes (.test/seed is tracked; .test/home is runtime state) ---
.test/home/
