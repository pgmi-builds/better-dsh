{
  "name": "better-dsh",
  "version": "0.2.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./py-sdk": {
      "types": "./lib/py-sdk.d.ts",
      "default": "./lib/py-sdk.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    }
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "control-prompt.md",
    "scripts/kernel-provision.mjs"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.cpSync('../docs','docs',{recursive:true})\"",
    "build": "tsdown && npm run build-client",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "kernel:venv": "node scripts/kernel-provision.mjs",
    "build-client": "tsx scripts/build-client.ts"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
