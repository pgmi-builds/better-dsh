{
  "name": "@pgmi-builds/dashr",
  "description": "DASHR: a persistent Python-kernel REPL for DeepSeek Harness (dsh) — the `eval` tool with `tool.*` bindings, sub-agents, and snapshots",
  "version": "0.1.9-a",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./py-sdk": {
      "types": "./lib/py-sdk.d.ts",
      "default": "./lib/py-sdk.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "control-prompt.md"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.cpSync('../docs','docs',{recursive:true})\"",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "kernel:venv": "uv venv .venv-kernel --python 3.11 && uv pip install --python .venv-kernel/bin/python ipykernel dill"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "diff": "^8.0.2",
    "file-type": "^21.3.0",
    "puppeteer-core": "25.3.0",
    "xxhash-wasm": "^1.1.0",
    "zeromq": "^6.6.0"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-linux-x64": "18.0.6",
    "@oh-my-pi/pi-natives-linux-arm64": "18.0.6",
    "@oh-my-pi/pi-natives-darwin-x64": "18.0.6",
    "@oh-my-pi/pi-natives-darwin-arm64": "18.0.6",
    "@oh-my-pi/pi-natives-win32-x64": "18.0.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-tool-presentation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-command-compact": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-persona": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-ask-user": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-goal": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-jobs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-pwsh": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-ralph": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-subagent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-subagent-control": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-todo": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-web": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-workflow": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow-worker-thread": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.10.5",
    "node-addon-require-builtin": "^0.1.5",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgmi-builds/dashr.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "repl",
    "eval",
    "ipython",
    "kernel",
    "agent",
    "plugin"
  ]
}
